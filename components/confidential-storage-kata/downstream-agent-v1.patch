diff --git a/src/agent/src/confidential_mount/contract.rs b/src/agent/src/confidential_mount/contract.rs
new file mode 100644
index 0000000..f2a938a
--- /dev/null
+++ b/src/agent/src/confidential_mount/contract.rs
@@ -0,0 +1,260 @@
+// Copyright (c) 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Versioned transport validation. Device locators never authorize key release.
+use anyhow::{bail, ensure, Result};
+use serde::{Deserialize, Serialize};
+
+pub const DRIVER: &str = "confidential-scsi-v1";
+pub const ROOT: &str = "/run/kata-containers/confidential-mounts";
+pub const POLICY_KEY: &str = "confidential-mounts.json";
+
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Request {
+    pub schema_version: u32,
+    pub volume_id: String,
+    pub profile_digest: String,
+    pub manifest_uri: String,
+    pub container_name: String,
+    pub device_path: String,
+    pub destination: String,
+    pub access: String,
+    pub operation: String,
+}
+
+/// Measured allowlist. Matching this alone is NOT an attestation verification:
+/// Trustee must require the approved InitData digest before releasing any key.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Policy {
+    pub schema_version: u32,
+    pub grants: Vec<Grant>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Grant {
+    pub volume_id: String,
+    pub profile_digest: String,
+    pub manifest_uri: String,
+    pub container_name: String,
+    pub destination: String,
+    pub access: String,
+    pub operation: String,
+}
+
+fn identifier(value: &str) -> bool {
+    (1..=63).contains(&value.len())
+        && (value.as_bytes()[0].is_ascii_lowercase() || value.as_bytes()[0].is_ascii_digit())
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+}
+
+pub fn parse(raw: &str) -> Result<Request> {
+    ensure!(raw.len() <= 4096, "mount request too large");
+    let req: Request = serde_json::from_str(raw)?;
+    ensure!(req.schema_version == 1, "unknown mount schema");
+    ensure!(
+        identifier(&req.volume_id) && identifier(&req.container_name),
+        "invalid mount identity"
+    );
+    let digest = req.profile_digest.strip_prefix("sha256:").unwrap_or("");
+    ensure!(
+        digest.len() == 64
+            && digest
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "invalid profile digest"
+    );
+    let parts: Vec<_> = req
+        .manifest_uri
+        .strip_prefix("kbs:///")
+        .unwrap_or("")
+        .split('/')
+        .collect();
+    ensure!(
+        parts.len() == 3 && parts.iter().all(|p| identifier(p)),
+        "invalid manifest URI"
+    );
+    ensure!(
+        identifier(req.device_path.strip_prefix("/dev/").unwrap_or("")),
+        "invalid device locator"
+    );
+    ensure!(req.operation == "reopen", "initialization is not supported");
+    ensure!(
+        (req.access == "rw" && req.destination == "/data")
+            || (req.access == "ro" && req.destination == "/models"),
+        "unsupported access/destination"
+    );
+    Ok(req)
+}
+
+impl Request {
+    pub fn grant(&self) -> Grant {
+        Grant {
+            volume_id: self.volume_id.clone(),
+            profile_digest: self.profile_digest.clone(),
+            manifest_uri: self.manifest_uri.clone(),
+            container_name: self.container_name.clone(),
+            destination: self.destination.clone(),
+            access: self.access.clone(),
+            operation: self.operation.clone(),
+        }
+    }
+    pub fn authorize(&self, measured_policy: &str, actual_container: &str) -> Result<()> {
+        ensure!(measured_policy.len() <= 65536, "mount policy too large");
+        let policy: Policy = serde_json::from_str(measured_policy)?;
+        ensure!(
+            policy.schema_version == 1 && !policy.grants.is_empty() && policy.grants.len() <= 16,
+            "invalid measured policy"
+        );
+        ensure!(
+            self.container_name == actual_container,
+            "container does not own mount"
+        );
+        let matching: Vec<_> = policy
+            .grants
+            .iter()
+            .filter(|g| g.volume_id == self.volume_id)
+            .collect();
+        if matching.len() != 1 || matching[0] != &self.grant() {
+            bail!("mount is not uniquely authorized by measured policy");
+        }
+        Ok(())
+    }
+    pub fn mount_point(&self, cid: &str) -> Result<String> {
+        ensure!(
+            !cid.is_empty()
+                && cid.len() <= 128
+                && cid.as_bytes()[0].is_ascii_alphanumeric()
+                && cid
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_'),
+            "invalid container ID"
+        );
+        Ok(format!("{ROOT}/{cid}/{}", self.volume_id))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn request() -> Request {
+        Request {
+            schema_version: 1,
+            volume_id: "scratch".into(),
+            profile_digest: format!("sha256:{}", "a".repeat(64)),
+            manifest_uri: "kbs:///default/volume-records/scratch".into(),
+            container_name: "app".into(),
+            device_path: "/dev/encrypted-data".into(),
+            destination: "/data".into(),
+            access: "rw".into(),
+            operation: "reopen".into(),
+        }
+    }
+    fn policy(r: &Request) -> String {
+        serde_json::to_string(&Policy {
+            schema_version: 1,
+            grants: vec![r.grant()],
+        })
+        .unwrap()
+    }
+    #[test]
+    fn valid_request_and_locator_not_authorization() {
+        let mut r = request();
+        let p = policy(&r);
+        r.device_path = "/dev/another".into();
+        let r = parse(&serde_json::to_string(&r).unwrap()).unwrap();
+        r.authorize(&p, "app").unwrap();
+        assert_eq!(
+            r.mount_point("container-123").unwrap(),
+            format!("{ROOT}/container-123/scratch")
+        );
+        assert!(r.mount_point("../escape").is_err());
+    }
+    #[test]
+    fn denies_substitution_of_every_authorization_field() {
+        let r = request();
+        let p = policy(&r);
+        for field in [
+            "volumeId",
+            "profileDigest",
+            "manifestUri",
+            "containerName",
+            "destination",
+            "access",
+            "operation",
+        ] {
+            let mut v = serde_json::to_value(&r).unwrap();
+            v[field] = "substituted".into();
+            let changed: Request = serde_json::from_value(v).unwrap();
+            assert!(changed.authorize(&p, "app").is_err(), "{}", field);
+        }
+        assert!(r.authorize(&p, "sidecar").is_err());
+        assert!(r.authorize("{}", "app").is_err());
+    }
+    #[test]
+    fn rejects_duplicate_grants_and_fields() {
+        let r = request();
+        let p = serde_json::to_string(&Policy {
+            schema_version: 1,
+            grants: vec![r.grant(), r.grant()],
+        })
+        .unwrap();
+        assert!(r.authorize(&p, "app").is_err());
+        let raw = serde_json::to_string(&r).unwrap();
+        assert!(parse(&raw.replacen(
+            "\"schemaVersion\":1",
+            "\"schemaVersion\":1,\"schemaVersion\":1",
+            1
+        ))
+        .is_err());
+        assert!(parse(&(raw + " {} ")).is_err());
+    }
+    #[test]
+    fn no_initialize_or_unsafe_paths() {
+        let r = request();
+        for (field, value) in [
+            ("operation", "initialize"),
+            ("devicePath", "/dev/../etc"),
+            ("destination", "/etc"),
+            ("access", "ro"),
+            ("manifestUri", "http://host/key"),
+            ("volumeId", "../escape"),
+        ] {
+            let mut v = serde_json::to_value(&r).unwrap();
+            v[field] = value.into();
+            assert!(parse(&v.to_string()).is_err(), "{}", field);
+        }
+        assert!(parse("null").is_err());
+        assert!(parse(&format!(
+            "{}{}",
+            " ".repeat(4097),
+            serde_json::to_string(&r).unwrap()
+        ))
+        .is_err());
+    }
+}
+
+#[cfg(test)]
+mod fixtures {
+    use super::*;
+    #[derive(Deserialize)]
+    struct Case {
+        name: String,
+        accept: bool,
+        raw: String,
+    }
+    #[test]
+    fn shared_go_rust_contract() {
+        let cases: Vec<Case> = serde_json::from_str(include_str!(
+            "../../../libs/protocols/confidential-mount-v1-fixtures.json"
+        ))
+        .unwrap();
+        for case in cases {
+            assert_eq!(parse(&case.raw).is_ok(), case.accept, "{}", case.name);
+        }
+    }
+}
