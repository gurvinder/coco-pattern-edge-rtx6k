diff --git a/src/runtime/pkg/confidentialmount/mount.go b/src/runtime/pkg/confidentialmount/mount.go
new file mode 100644
index 0000000..71513c4
--- /dev/null
+++ b/src/runtime/pkg/confidentialmount/mount.go
@@ -0,0 +1,197 @@
+// Copyright (c) 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package confidentialmount transports an untrusted volume locator to the guest.
+// It does not authorize mounts, release credentials, or initialize storage.
+package confidentialmount
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"path"
+	"regexp"
+	"strings"
+
+	grpc "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+const Annotation = "io.katacontainers.confidential-mount.v1"
+const Driver = "confidential-scsi-v1"
+const GuestRoot = "/run/kata-containers/confidential-mounts"
+const MaxRequestBytes = 4096
+
+// Request describes one existing filesystem. A trusted guest policy must match
+// all authorization fields; DevicePath is only an untrusted device locator.
+type Request struct {
+	SchemaVersion int    `json:"schemaVersion"`
+	VolumeID      string `json:"volumeId"`
+	ProfileDigest string `json:"profileDigest"`
+	ManifestURI   string `json:"manifestUri"`
+	ContainerName string `json:"containerName"`
+	DevicePath    string `json:"devicePath"`
+	Destination   string `json:"destination"`
+	Access        string `json:"access"`
+	Operation     string `json:"operation"`
+}
+
+var identifier = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,62}$`)
+var digest = regexp.MustCompile(`^sha256:[0-9a-f]{64}$`)
+var resource = regexp.MustCompile(`^kbs:///[a-z0-9][a-z0-9-]{0,62}/[a-z0-9][a-z0-9-]{0,62}/[a-z0-9][a-z0-9-]{0,62}$`)
+
+// Parse rejects ambiguous/unknown fields rather than permitting differences
+// between the Go and Rust JSON parsers at the security boundary.
+func Parse(raw string) (Request, error) {
+	var req Request
+	if len(raw) > MaxRequestBytes {
+		return req, fmt.Errorf("confidential mount request too large")
+	}
+	dec := json.NewDecoder(strings.NewReader(raw))
+	token, err := dec.Token()
+	if err != nil || token != json.Delim('{') {
+		return req, fmt.Errorf("expected mount object")
+	}
+	seen := map[string]bool{}
+	for dec.More() {
+		token, err = dec.Token()
+		if err != nil {
+			return req, err
+		}
+		key, ok := token.(string)
+		if !ok || seen[key] {
+			return req, fmt.Errorf("duplicate mount field")
+		}
+		seen[key] = true
+		var value json.RawMessage
+		if err = dec.Decode(&value); err != nil {
+			return req, err
+		}
+	}
+	if _, err = dec.Token(); err != nil {
+		return req, err
+	}
+	if _, err = dec.Token(); err != io.EOF {
+		return req, fmt.Errorf("trailing mount data")
+	}
+	dec = json.NewDecoder(strings.NewReader(raw))
+	dec.DisallowUnknownFields()
+	if err = dec.Decode(&req); err != nil {
+		return req, err
+	}
+	// encoding/json otherwise accepts case-insensitive field aliases.
+	for key := range seen {
+		switch key {
+		case "schemaVersion", "volumeId", "profileDigest", "manifestUri", "containerName", "devicePath", "destination", "access", "operation":
+		default:
+			return req, fmt.Errorf("unknown mount field %q", key)
+		}
+	}
+	if req.SchemaVersion != 1 || !identifier.MatchString(req.VolumeID) || !identifier.MatchString(req.ContainerName) || !digest.MatchString(req.ProfileDigest) || !resource.MatchString(req.ManifestURI) {
+		return req, fmt.Errorf("invalid confidential mount identity")
+	}
+	if req.Operation != "reopen" {
+		return req, fmt.Errorf("only reopening existing volumes is supported")
+	}
+	if (req.Access != "rw" || req.Destination != "/data") && (req.Access != "ro" || req.Destination != "/models") {
+		return req, fmt.Errorf("unsupported access/destination")
+	}
+	if !strings.HasPrefix(req.DevicePath, "/dev/") || path.Clean(req.DevicePath) != req.DevicePath || !identifier.MatchString(strings.TrimPrefix(req.DevicePath, "/dev/")) {
+		return req, fmt.Errorf("invalid source device path")
+	}
+	return req, nil
+}
+
+// Convert removes the app's raw device and replaces it with a guest filesystem
+// bind. An old agent rejects the distinct driver instead of mounting plaintext.
+// All checks precede mutations, so failures leave the original spec intact.
+func Convert(spec *specs.Spec, devices []*grpc.Device, cid string) ([]*grpc.Device, []*grpc.Storage, error) {
+	raw, enabled := spec.Annotations[Annotation]
+	if !enabled {
+		return devices, nil, nil
+	}
+	req, err := Parse(raw)
+	if err != nil {
+		return nil, nil, err
+	}
+	name := spec.Annotations["io.kubernetes.cri.container-name"]
+	if name == "" {
+		name = spec.Annotations["io.kubernetes.cri-o.ContainerName"]
+	}
+	if name == "" {
+		return nil, nil, fmt.Errorf("missing container identity")
+	}
+	if name != req.ContainerName {
+		return devices, nil, nil
+	}
+	if !regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$`).MatchString(cid) {
+		return nil, nil, fmt.Errorf("invalid container ID")
+	}
+	if spec.Linux == nil {
+		return nil, nil, fmt.Errorf("missing Linux spec")
+	}
+	selected := -1
+	for i, d := range devices {
+		if d.ContainerPath == req.DevicePath {
+			if selected >= 0 || d.Type != "scsi" || !regexp.MustCompile(`^[0-9]+:[0-9]+$`).MatchString(d.Id) {
+				return nil, nil, fmt.Errorf("ambiguous or unsupported source device")
+			}
+			selected = i
+		}
+	}
+	if selected < 0 {
+		return nil, nil, fmt.Errorf("source device not attached")
+	}
+	rawIndex := -1
+	for i, d := range spec.Linux.Devices {
+		if d.Type == "b" {
+			if d.Path != req.DevicePath || rawIndex >= 0 {
+				return nil, nil, fmt.Errorf("only one raw block source is supported")
+			}
+			rawIndex = i
+		} else if d.Path == req.DevicePath {
+			return nil, nil, fmt.Errorf("source is not a block device")
+		}
+	}
+	if rawIndex < 0 {
+		return nil, nil, fmt.Errorf("source absent from OCI spec")
+	}
+	mountPoint := path.Join(GuestRoot, cid, req.VolumeID)
+	for _, m := range spec.Mounts {
+		if overlaps(m.Destination, req.Destination) || overlaps(m.Source, GuestRoot) {
+			return nil, nil, fmt.Errorf("overlapping mount")
+		}
+	}
+	data, _ := json.Marshal(req)
+	storage := &grpc.Storage{Driver: Driver, Source: devices[selected].Id, Fstype: "ext4", MountPoint: mountPoint, DriverOptions: []string{string(data)}, Options: []string{req.Access, "nosuid", "nodev", "noexec"}}
+	remaining := make([]*grpc.Device, 0, len(devices)-1)
+	for i, d := range devices {
+		if i != selected {
+			remaining = append(remaining, d)
+		}
+	}
+	linuxDevices := append([]specs.LinuxDevice{}, spec.Linux.Devices[:rawIndex]...)
+	linuxDevices = append(linuxDevices, spec.Linux.Devices[rawIndex+1:]...)
+	spec.Linux.Devices = linuxDevices
+	if spec.Linux.Resources != nil {
+		rules := make([]specs.LinuxDeviceCgroup, 0)
+		for _, rule := range spec.Linux.Resources.Devices {
+			if rule.Allow && (rule.Type == "b" || rule.Type == "a" || rule.Type == "") {
+				continue
+			}
+			rules = append(rules, rule)
+		}
+		spec.Linux.Resources.Devices = rules
+	}
+	spec.Mounts = append(spec.Mounts, specs.Mount{Destination: req.Destination, Type: "bind", Source: mountPoint, Options: []string{"bind", req.Access, "nosuid", "nodev", "noexec"}})
+	return remaining, []*grpc.Storage{storage}, nil
+}
+
+func overlaps(a, b string) bool {
+	if a == "" {
+		return false
+	}
+	a = path.Clean(a)
+	b = path.Clean(b)
+	return a == b || a == "/" || b == "/" || strings.HasPrefix(a, b+"/") || strings.HasPrefix(b, a+"/")
+}
diff --git a/src/runtime/pkg/confidentialmount/mount_test.go b/src/runtime/pkg/confidentialmount/mount_test.go
new file mode 100644
index 0000000..a9a7939
--- /dev/null
+++ b/src/runtime/pkg/confidentialmount/mount_test.go
@@ -0,0 +1,197 @@
+// Copyright (c) 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+package confidentialmount
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	grpc "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"google.golang.org/protobuf/proto"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func valid() Request {
+	return Request{1, "scratch", "sha256:" + strings.Repeat("a", 64), "kbs:///default/volume-records/scratch", "app", "/dev/encrypted-data", "/data", "rw", "reopen"}
+}
+func encode(r Request) string { b, _ := json.Marshal(r); return string(b) }
+func fixture() (*specs.Spec, []*grpc.Device) {
+	return &specs.Spec{Process: &specs.Process{User: specs.User{UID: 1000, GID: 1000}, NoNewPrivileges: true}, Annotations: map[string]string{Annotation: encode(valid()), "io.kubernetes.cri-o.ContainerName": "app"}, Linux: &specs.Linux{Devices: []specs.LinuxDevice{{Path: "/dev/encrypted-data", Type: "b", Major: 8, Minor: 16}, {Path: "/dev/null", Type: "c", Major: 1, Minor: 3}}, Resources: &specs.LinuxResources{Devices: []specs.LinuxDeviceCgroup{{Allow: true, Type: "b", Access: "rwm"}, {Allow: true, Type: "c", Access: "rwm"}, {Allow: false, Type: "b", Access: "rwm"}}}}, Mounts: []specs.Mount{{Destination: "/proc", Type: "proc", Source: "proc"}}}, []*grpc.Device{{Type: "scsi", Id: "1:0", ContainerPath: "/dev/encrypted-data"}}
+}
+func TestConversionRemovesRawDevice(t *testing.T) {
+	for _, access := range []string{"rw", "ro"} {
+		t.Run(access, func(t *testing.T) {
+			spec, devices := fixture()
+			r := valid()
+			r.Access = access
+			if access == "ro" {
+				r.Destination = "/models"
+			}
+			spec.Annotations[Annotation] = encode(r)
+			remaining, storages, err := Convert(spec, devices, "container-123")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(remaining) != 0 || len(storages) != 1 || len(spec.Linux.Devices) != 1 || spec.Linux.Devices[0].Type != "c" {
+				t.Fatal("raw device leaked")
+			}
+			for _, rule := range spec.Linux.Resources.Devices {
+				if rule.Allow && rule.Type == "b" {
+					t.Fatal("block access leaked")
+				}
+			}
+			if storages[0].Driver != Driver || storages[0].Source != "1:0" || storages[0].Shared {
+				t.Fatal("bad storage translation")
+			}
+			m := spec.Mounts[len(spec.Mounts)-1]
+			if m.Source != storages[0].MountPoint || m.Destination != r.Destination || !reflect.DeepEqual(m.Options, []string{"bind", access, "nosuid", "nodev", "noexec"}) {
+				t.Fatal("bad filesystem bind")
+			}
+		})
+	}
+}
+func TestInvalidRequests(t *testing.T) {
+	raw := encode(valid())
+	cases := map[string]string{
+		"duplicate":  strings.Replace(raw, `"schemaVersion":1`, `"schemaVersion":1,"schemaVersion":1`, 1),
+		"case-alias": strings.Replace(raw, "volumeId", "VolumeId", 1),
+		"unknown":    strings.Replace(raw, `"schemaVersion":1`, `"schemaVersion":1,"format":true`, 1),
+		"trailing":   raw + " {}", "null": "null", "oversize": strings.Repeat(" ", 4097) + raw,
+	}
+	mutations := map[string]func(*Request){
+		"format":        func(r *Request) { r.Operation = "initialize" },
+		"version":       func(r *Request) { r.SchemaVersion = 2 },
+		"traversal":     func(r *Request) { r.DevicePath = "/dev/../etc/shadow" },
+		"nested-device": func(r *Request) { r.DevicePath = "/dev/mapper/secret" },
+		"target":        func(r *Request) { r.Destination = "/etc" },
+		"model-rw":      func(r *Request) { r.Destination = "/models" },
+		"profile":       func(r *Request) { r.ProfileDigest = "latest" },
+		"uri-query":     func(r *Request) { r.ManifestURI += "?x=1" },
+		"uri-http":      func(r *Request) { r.ManifestURI = "http://host/record" },
+		"identity":      func(r *Request) { r.VolumeID = "../scratch" },
+	}
+	for name, change := range mutations {
+		r := valid()
+		change(&r)
+		cases[name] = encode(r)
+	}
+	for name, raw := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := Parse(raw); err == nil {
+				t.Fatal("accepted invalid request")
+			}
+		})
+	}
+}
+func TestFailureDoesNotMutateSpec(t *testing.T) {
+	cases := map[string]func(*specs.Spec, []*grpc.Device){
+		"other-block": func(s *specs.Spec, d []*grpc.Device) {
+			s.Linux.Devices = append(s.Linux.Devices, specs.LinuxDevice{Path: "/dev/alias", Type: "b", Major: 8, Minor: 16})
+		},
+		"wrong-driver":   func(s *specs.Spec, d []*grpc.Device) { d[0].Type = "blk" },
+		"missing-source": func(s *specs.Spec, d []*grpc.Device) { d[0].ContainerPath = "/dev/other" },
+		"bad-locator":    func(s *specs.Spec, d []*grpc.Device) { d[0].Id = "../1:0" },
+		"missing-oci":    func(s *specs.Spec, d []*grpc.Device) { s.Linux.Devices = nil },
+		"target-overlap": func(s *specs.Spec, d []*grpc.Device) {
+			s.Mounts = append(s.Mounts, specs.Mount{Destination: "/data/child", Source: "tmpfs"})
+		},
+		"source-overlap": func(s *specs.Spec, d []*grpc.Device) {
+			s.Mounts = append(s.Mounts, specs.Mount{Destination: "/other", Source: GuestRoot})
+		},
+	}
+	for name, change := range cases {
+		t.Run(name, func(t *testing.T) {
+			s, d := fixture()
+			change(s, d)
+			before, _ := json.Marshal(s)
+			if _, _, err := Convert(s, d, "container-123"); err == nil {
+				t.Fatal("accepted invalid transport")
+			}
+			after, _ := json.Marshal(s)
+			if string(before) != string(after) {
+				t.Fatal("partially mutated OCI")
+			}
+		})
+	}
+}
+func TestNotSelected(t *testing.T) {
+	s, d := fixture()
+	s.Annotations["io.kubernetes.cri-o.ContainerName"] = "sidecar"
+	remaining, m, err := Convert(s, d, "container-123")
+	if err != nil || len(m) != 0 || !reflect.DeepEqual(remaining, d) {
+		t.Fatal("unrelated container changed")
+	}
+}
+func TestDuplicateDeviceAndInvalidContainerID(t *testing.T) {
+	s, d := fixture()
+	if _, _, err := Convert(s, append(d, d[0]), "container-123"); err == nil {
+		t.Fatal("duplicate device accepted")
+	}
+	s, d = fixture()
+	if _, _, err := Convert(s, d, "../escape"); err == nil {
+		t.Fatal("container traversal accepted")
+	}
+}
+
+func TestSharedContractFixtures(t *testing.T) {
+	data, err := os.ReadFile("../../../libs/protocols/confidential-mount-v1-fixtures.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var cases []struct {
+		Name   string `json:"name"`
+		Accept bool   `json:"accept"`
+		Raw    string `json:"raw"`
+	}
+	if err = json.Unmarshal(data, &cases); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range cases {
+		t.Run(c.Name, func(t *testing.T) {
