+        assert!(!entry.closed());
+        service.do_remove_container(remove()).await.unwrap();
+        service.do_remove_container(remove()).await.unwrap();
+        assert!(entry.closed());
+        assert_eq!(owner.closes.load(Ordering::SeqCst), 1);
