+    #[tokio::test]
+    async fn managed_storage_real_sigchld_unblocks_rpc_wait_and_teardown() {
+        let service = service();
+        let owner = TestOwner::new();
+        install(&service, owner.clone()).await;
+        // This is the agent's actual dispatcher and a real child, but the owner
+        // is a test double: this test does not attest or mount storage.
+        let child = std::process::Command::new("/bin/sh")
+            .args(["-c", "exit 37"])
+            .spawn()
+            .unwrap();
+        owner.pid.store(child.id() as i32, Ordering::SeqCst);
+        let unknown = std::process::Command::new("/bin/sh")
+            .args(["-c", "exit 19"])
+            .spawn()
+            .unwrap();
+        let waiter = {
+            let s = service.clone();
+            tokio::spawn(async move { s.do_wait_process(wait()).await.unwrap().status })
+        };
+        owner.wait_on_exit.store(true, Ordering::SeqCst);
+        let (tx, rx) = tokio::sync::oneshot::channel();
+        service.sandbox.lock().await.sender = Some(tx);
+        let teardown = {
+            let s = service.clone();
+            tokio::spawn(async move { s.do_destroy_sandbox().await })
+        };
+        owner.entered.notified().await;
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                crate::signal::handle_sigchild(
+                    slog::Logger::root(slog::Discard, o!()),
+                    service.sandbox.clone(),
+                )
+                .await
+                .unwrap();
+                if waiter.is_finished() {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await
+        .unwrap();
+        assert_eq!(waiter.await.unwrap(), 37);
+        tokio::time::timeout(Duration::from_secs(2), teardown)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert_eq!(rx.await.unwrap(), 1);
+        // Drain the unknown helper too; the managed status remains unchanged.
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        crate::signal::handle_sigchild(
+            slog::Logger::root(slog::Discard, o!()),
+            service.sandbox.clone(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(service.do_wait_process(wait()).await.unwrap().status, 37);
+        drop((child, unknown));
+    }
