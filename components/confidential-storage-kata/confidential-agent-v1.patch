+        // is a test double: this test does not attest or mount storage.
+        let child = std::process::Command::new("/bin/sh")
+            .args(["-c", "exit 37"])
+            .spawn()
+            .unwrap();
+        owner.pid.store(child.id() as i32, Ordering::SeqCst);
+        let unknown = std::process::Command::new("/bin/sh")
+            .args(["-c", "exit 19"])
+            .spawn()
+            .unwrap();
+        let waiter = {
+            let s = service.clone();
+            tokio::spawn(async move { s.do_wait_process(wait()).await.unwrap().status })
+        };
+        owner.wait_on_exit.store(true, Ordering::SeqCst);
+        let (tx, rx) = tokio::sync::oneshot::channel();
+        service.sandbox.lock().await.sender = Some(tx);
+        let teardown = {
+            let s = service.clone();
+            tokio::spawn(async move { s.do_destroy_sandbox().await })
+        };
+        owner.entered.notified().await;
+        tokio::time::timeout(Duration::from_secs(3), async {
