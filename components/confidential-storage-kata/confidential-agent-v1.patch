+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await
+        .unwrap();
+        assert_eq!(waiter.await.unwrap(), 37);
+        tokio::time::timeout(Duration::from_secs(2), teardown)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
