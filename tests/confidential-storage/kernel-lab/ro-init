#!/bin/sh
# Synthetic non-TEE lab, never a deployment initrd.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t devtmpfs devtmpfs /dev
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /run /tmp /models /dev/mapper
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs tmpfs /tmp
finish() { sync; reboot -f; sleep 5; }
fail() { echo "COCO_TEST_FAIL:$*"; finish; exit 1; }
trap 'fail unexpected-exit' EXIT
set -eu
case " $(cat /proc/cmdline) " in *' coco.ro.lab=1 '*) ;; *) fail missing-guard;; esac
for module in virtio_mmio virtio_blk dm_mod dm_crypt dm_verity ext4 sha256_generic xts aes_generic; do
    modprobe "$module" || fail "module-$module"
done
for i in $(seq 1 20); do [ -b /dev/vda ] && break; sleep 1; done
[ -b /dev/vda ] || fail missing-disk
mknod /dev/mapper/control c 10 236 2>/dev/null || true
/usr/sbin/rust-opener-lab || fail ro-opener
echo COCO_TEST_PASS:ro-kernel-lab
trap - EXIT
finish
