+#[cfg(test)]
+mod wire_test {
+    use super::*;
+    use base64::{engine::general_purpose::STANDARD, Engine};
+    use protobuf::Message;
+    #[test]
+    fn consumes_actual_go_protobuf_request() {
+        let wire = STANDARD
+            .decode(include_str!("../../../libs/protocols/confidential-mount-v1-wire.b64").trim())
+            .unwrap();
+        let req = CreateContainerRequest::parse_from_bytes(&wire).unwrap();
+        let spec: oci::Spec = req.OCI.clone().into_option().unwrap().into();
+        let request = contract::parse(&req.storages[0].driver_options[0]).unwrap();
+        validate_transport(&req, &spec, &request).unwrap();
+        assert_eq!(request.volume_id, "scratch");
+        assert_eq!(request.access, "rw");
+        assert!(req.devices.is_empty());
+        assert!(preflight(&req, &spec).is_err());
+    }
+}
