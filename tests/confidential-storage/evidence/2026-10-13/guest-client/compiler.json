{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "storage-client-compiler",
    "namespace": "confidential-storage-test",
    "labels": {
      "app": "storage-client-compiler",
      "coco-storage-test": "true"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "securityContext": {
      "runAsNonRoot": true,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "compiler",
        "image": "docker.io/library/rust@sha256:4ec71e955e6c08aeb238885083222ddff79d82eb87654a96c76e38e94da1a53b",
        "command": [
          "sleep",
          "14400"
        ],
        "resources": {
          "requests": {
            "cpu": "2",
            "memory": "4Gi",
            "ephemeral-storage": "8Gi"
          },
          "limits": {
            "cpu": "4",
            "memory": "8Gi",
            "ephemeral-storage": "34Gi"
          }
        },
        "securityContext": {
          "runAsUser": 1001100000,
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "volumeMounts": [
          {
            "name": "build",
            "mountPath": "/build"
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "build",
        "emptyDir": {
          "sizeLimit": "32Gi"
        }
      },
      {
        "name": "tmp",
        "emptyDir": {
          "sizeLimit": "1Gi"
        }
      }
    ]
  }
}
