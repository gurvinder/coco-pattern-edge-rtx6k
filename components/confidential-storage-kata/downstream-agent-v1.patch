@@ -0,0 +1,348 @@
+// Copyright (c) 2026 Red Hat, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Fail-closed preflight for guest-owned persistent filesystem mounts.
+//! Kept unavailable until CDH can bind profile, authority receipt and session.
+mod contract;
+
+use anyhow::{bail, ensure, Context, Result};
+use kata_types::initdata::InitData;
+use oci_spec::runtime as oci;
+use protocols::agent::CreateContainerRequest;
+use std::path::Path;
+
+pub fn preflight(req: &CreateContainerRequest, spec: &oci::Spec) -> Result<()> {
+    let mounts: Vec<_> = req
+        .storages
+        .iter()
+        .filter(|s| s.driver == contract::DRIVER)
+        .collect();
+    let reserved_bind = spec.mounts().as_ref().is_some_and(|mounts| {
+        mounts.iter().any(|m| {
+            m.source()
+                .as_ref()
+                .is_some_and(|s| s.starts_with(contract::ROOT))
+        })
+    });
+    if mounts.is_empty() {
+        ensure!(
+            !reserved_bind,
+            "reserved confidential mount source without storage request"
+        );
+        return Ok(());
+    }
+    ensure!(
+        cfg!(feature = "agent-policy") && cfg!(feature = "init-data"),
+        "confidential mounts require measured policy support"
+    );
+    ensure!(
+        mounts.len() == 1,
+        "only one confidential mount per container is supported"
+    );
+    let storage = mounts[0];
+    ensure!(
+        storage.driver_options.len() == 1,
+        "expected one typed mount request"
+    );
+    let request = contract::parse(&storage.driver_options[0])?;
+    let content =
+        std::fs::read(crate::initdata::INITDATA_TOML_PATH).context("missing guest InitData")?;
+    let initdata: InitData = toml::from_slice(&content).context("invalid guest InitData")?;
+    initdata.validate()?;
+    let policy = initdata
+        .get_coco_data(contract::POLICY_KEY)
+        .context("missing measured mount policy")?;
+    request.authorize(policy, &kata_types::k8s::container_name(spec))?;
+    validate_transport(req, spec, &request)?;
+    // The prototype ActivateVolume RPC only carries device_id + manifest_uri.
+    // It cannot enforce this request's profile/session/authority bindings. Do not
+    // silently drop those fields or fall back to ephemeral SecureMount.
+    bail!("confidential filesystem activation unavailable: profile-bound authority/CDH API is required")
+}
+
+fn validate_transport(
+    req: &CreateContainerRequest,
+    spec: &oci::Spec,
+    request: &contract::Request,
+) -> Result<()> {
+    let selected: Vec<_> = req
+        .storages
+        .iter()
+        .filter(|s| s.driver == contract::DRIVER)
+        .collect();
+    ensure!(selected.len() == 1, "expected one confidential storage");
+    let storage = selected[0];
+    let mount_point = request.mount_point(&req.container_id)?;
+    for other in &req.storages {
+        if std::ptr::eq(other, storage) {
+            continue;
+        }
+        ensure!(
+            !Path::new(&other.mount_point).starts_with(contract::ROOT)
+                && !Path::new(contract::ROOT).starts_with(&other.mount_point),
+            "storage overlaps private guest mount tree"
+        );
+    }
+    ensure!(
+        storage.mount_point == mount_point
+            && storage.fstype == "ext4"
+            && !storage.shared
+            && storage.fs_group.is_none(),
+        "unsupported filesystem mount metadata"
+    );
+    ensure!(
+        storage.options == [request.access.as_str(), "nosuid", "nodev", "noexec"],
+        "unsafe filesystem options"
+    );
+    let scsi: Vec<_> = storage.source.split(':').collect();
+    ensure!(
+        scsi.len() == 2
+            && scsi
+                .iter()
+                .all(|v| !v.is_empty() && v.bytes().all(|b| b.is_ascii_digit())),
+        "invalid SCSI locator"
+    );
+    ensure!(
+        req.devices
+            .iter()
+            .all(|d| d.container_path != request.device_path
+                && d.type_ != "scsi"
+                && d.type_ != "blk"
+                && d.type_ != "secure-volume"),
+        "raw storage device exposed to application"
+    );
+    let process = spec
+        .process()
+        .as_ref()
+        .context("missing application process")?;
+    ensure!(
+        process.user().uid() != 0 && process.no_new_privileges().unwrap_or(false),
+        "application must be non-root with no-new-privileges"
+    );
+    if let Some(caps) = process.capabilities() {
+        ensure!(
+            [
+                caps.bounding(),
+                caps.effective(),
+                caps.permitted(),
+                caps.inheritable(),
+                caps.ambient()
+            ]
+            .iter()
+            .all(|set| set.as_ref().is_none_or(|set| set.is_empty())),
+            "application capabilities must be dropped"
+        );
+    }
+    let linux = spec.linux().as_ref().context("missing Linux spec")?;
+    if let Some(devices) = linux.devices() {
+        ensure!(
+            devices.iter().all(|d| d.typ() != oci::LinuxDeviceType::B),
+            "raw block device exposed to application"
+        );
+    }
+    let app_mounts = spec
+        .mounts()
+        .as_ref()
+        .context("missing application mounts")?;
+    let selected: Vec<_> = app_mounts
+        .iter()
+        .filter(|m| m.destination() == Path::new(&request.destination))
+        .collect();
+    ensure!(selected.len() == 1, "expected exactly one application bind");
+    let bind = selected[0];
+    ensure!(
+        bind.source().as_deref() == Some(Path::new(&mount_point))
+            && bind.typ().as_deref() == Some("bind"),
+        "redirected application bind"
+    );
+    let expected: Vec<String> = ["bind", request.access.as_str(), "nosuid", "nodev", "noexec"]
+        .iter()
+        .map(|v| (*v).to_owned())
+        .collect();
+    ensure!(
+        bind.options().as_ref() == Some(&expected),
+        "unsafe application bind options"
+    );
+    for m in app_mounts {
+        if std::ptr::eq(m, bind) {
+            continue;
+        }
+        let dest = m.destination();
+        ensure!(
+            !dest.starts_with(&request.destination)
+                && !Path::new(&request.destination).starts_with(dest),
+            "overlapping destination"
+        );
+        if let Some(source) = m.source() {
+            ensure!(
+                !source.starts_with(contract::ROOT)
+                    && !Path::new(contract::ROOT).starts_with(source),
+                "aliased confidential mount source"
+            );
+        }
+    }
+    // Refcount reuse must not bypass request validation or substitute a source.
+    ensure!(
+        req.storages
+            .iter()
+            .filter(|s| s.mount_point == mount_point)
+            .count()
+            == 1,
+        "duplicate storage mount point"
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use protocols::agent::Storage;
+    use std::collections::HashMap;
+
+    fn fixture() -> (CreateContainerRequest, oci::Spec, contract::Request) {
+        let request = contract::Request {
+            schema_version: 1,
+            volume_id: "scratch".into(),
+            profile_digest: format!("sha256:{}", "a".repeat(64)),
+            manifest_uri: "kbs:///default/volume-records/scratch".into(),
+            container_name: "app".into(),
+            device_path: "/dev/encrypted-data".into(),
+            destination: "/data".into(),
+            access: "rw".into(),
+            operation: "reopen".into(),
+        };
+        let mount_point = request.mount_point("container-123").unwrap();
+        let storage = Storage {
+            driver: contract::DRIVER.into(),
+            source: "1:0".into(),
+            fstype: "ext4".into(),
+            mount_point: mount_point.clone(),
+            options: vec![
+                "rw".into(),
+                "nosuid".into(),
+                "nodev".into(),
+                "noexec".into(),
+            ],
+            driver_options: vec![serde_json::to_string(&request).unwrap()],
+            ..Default::default()
+        };
+        let req = CreateContainerRequest {
+            container_id: "container-123".into(),
+            storages: vec![storage],
+            ..Default::default()
+        };
+        let mut spec = oci::Spec::default();
+        spec.set_linux(Some(oci::Linux::default()));
+        let mut process = oci::Process::default();
+        let mut user = oci::User::default();
+        user.set_uid(1000);
+        user.set_gid(1000);
+        process.set_user(user);
+        process.set_no_new_privileges(Some(true));
+        process.set_capabilities(None);
+        spec.set_process(Some(process));
+        spec.set_annotations(Some(HashMap::from([(
+            "io.kubernetes.cri-o.ContainerName".into(),
+            "app".into(),
+        )])));
+        let mut mount = oci::Mount::default();
+        mount.set_destination("/data".into());
+        mount.set_source(Some(mount_point.into()));
+        mount.set_typ(Some("bind".into()));
+        mount.set_options(Some(vec![
+            "bind".into(),
+            "rw".into(),
+            "nosuid".into(),
+            "nodev".into(),
+            "noexec".into(),
+        ]));
+        spec.set_mounts(Some(vec![mount]));
+        (req, spec, request)
+    }
+    #[test]
+    fn transport_checks_bind_and_denies_unsafe_options() {
+        let (mut req, spec, request) = fixture();
+        validate_transport(&req, &spec, &request).unwrap();
+        req.storages[0].options.push("exec".into());
+        assert!(validate_transport(&req, &spec, &request).is_err());
+    }
+    #[test]
+    fn denies_duplicate_and_redirected_storage() {
+        let (mut req, spec, request) = fixture();
+        req.storages.push(req.storages[0].clone());
+        assert!(validate_transport(&req, &spec, &request).is_err());
+        req.storages.pop();
+        req.storages[0].mount_point = "/other".into();
+        assert!(validate_transport(&req, &spec, &request).is_err());
+    }
+    #[test]
+    fn denies_raw_device_exposure() {
+        let (mut req, spec, request) = fixture();
+        req.devices.push(protocols::agent::Device {
+            type_: "scsi".into(),
+            container_path: request.device_path.clone(),
+            ..Default::default()
+        });
+        assert!(validate_transport(&req, &spec, &request).is_err());
+    }
+    #[test]
+    fn ordinary_requests_pass_but_reserved_mount_never_does() {
+        let req = CreateContainerRequest::default();
+        preflight(&req, &oci::Spec::default()).unwrap();
+        let (_, spec, _) = fixture();
+        assert!(preflight(&req, &spec).is_err());
+    }
+    #[test]
+    fn unavailable_activation_never_falls_back() {
+        let (req, spec, _) = fixture();
+        // No InitData is installed by this unit test; no CDH call is made.
+        assert!(preflight(&req, &spec).is_err());
+    }
+    #[test]
+    fn denies_privileged_application_and_storage_alias() {
+        let (mut req, mut spec, request) = fixture();
+        spec.process_mut().as_mut().unwrap().user_mut().set_uid(0);
+        assert!(validate_transport(&req, &spec, &request).is_err());
+        spec.process_mut()
+            .as_mut()
+            .unwrap()
+            .user_mut()
+            .set_uid(1000);
+        spec.process_mut()
+            .as_mut()
+            .unwrap()
+            .set_no_new_privileges(Some(false));
+        assert!(validate_transport(&req, &spec, &request).is_err());
+        spec.process_mut()
+            .as_mut()
+            .unwrap()
+            .set_no_new_privileges(Some(true));
+        req.storages.push(Storage {
+            driver: "local".into(),
+            mount_point: contract::ROOT.into(),
+            ..Default::default()
+        });
+        assert!(validate_transport(&req, &spec, &request).is_err());
+    }
+}
