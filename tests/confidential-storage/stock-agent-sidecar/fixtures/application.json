        "\"\"\"Measured startup for the isolated two-volume GPU candidate.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\n\nINVENTORY = [{'bytes': 11343, 'path': 'LICENSE', 'sha256': '832dd9e00a68dd83b3c3fb9f5588dad7dcf337a0db50f7d9483f310cd292e92e'}, {'bytes': 726, 'path': 'config.json', 'sha256': '660db3b73d788119c04535e48cf9be5f55bc3100841a718637ae695b442f27dd'}, {'bytes': 239, 'path': 'generation_config.json', 'sha256': '2325da0f15bb848e018c5ae071b7943332e9f871d6b60e2ed22ca97d4cb993d2'}, {'bytes': 1671853, 'path': 'merges.txt', 'sha256': '8831e4f1a044471340f7c0a83d7bd71306a5b867e95fd870f74d0c5308a904d5'}, {'bytes': 1503300328, 'path': 'model.safetensors', 'sha256': 'f47f71177f32bcd101b7573ec9171e6a57f4f4d31148d38e382306f42996874b'}, {'bytes': 1079, 'path': 'publisher-source.json', 'sha256': 'd5945b210faf8c6c869fb72de03acd0e386507dae493107fed818ea9bb6948d8'}, {'bytes': 11422654, 'path': 'tokenizer.json', 'sha256': 'aeb13307a71acd8fe81861d94ad54ab689df773318809eed3cbe794b4492dae4'}, {'bytes': 9732, 'path': 'tokenizer_config.json', 'sha256': 'd5d09f07b48c3086c508b30d1c9114bd1189145b74e982a265350c923acd8101'}, {'bytes': 2776833, 'path': 'vocab.json', 'sha256': 'ca10d7e9fb3ed18575dd1e277a2579c16d108e32f27439684afa0e10b1440910'}]\nMODEL = Path('/models/qwen')\nDATA = Path('/data')\n\n\ndef require(condition, message):\n    if not condition:\n        raise RuntimeError(message)\n\n\nrequire(os.getuid() == 1001 and os.getgid() == 1001, 'unexpected application owner')\nstatus = dict(line.split(':', 1) for line in Path('/proc/self/status').read_text().splitlines() if ':' in line)\nrequire(int(status['CapEff'].strip(), 16) == 0, 'application has capabilities')\nrequire(status['NoNewPrivs'].strip() == '1', 'privilege escalation is enabled')\nfor private in ['/dev/coco-volume-0', '/dev/coco-volume-1', '/dev/mapper/control',\n                '/run/confidential-containers/cdh.sock', '/run/coco/storage-service/agent.sock']:\n    require(not Path(private).exists(), 'guest control or raw disk visible to application')\nrequire(os.statvfs(MODEL).f_flag & os.ST_RDONLY, 'model mount is writable')\nrequire(not os.statvfs(DATA).f_flag & os.ST_RDONLY, 'data mount is read-only')\nfor item in INVENTORY:\n    path = MODEL / item['path']\n    require(path.is_file() and not path.is_symlink(), 'unexpected model file type')\n    require(path.stat().st_size == item['bytes'], 'model size mismatch')\n    with path.open('rb') as stream:\n        digest = hashlib.file_digest(stream, 'sha256').hexdigest()\n    require(digest == item['sha256'], 'model file hash mismatch')\nprint('STORAGE_MODEL_RO_HASHES_PASS', flush=True)\n# This is a disposable persistence probe, not a model freshness/anti-replay counter.\ncanary = DATA / 'gpu-storage-canary.json'\nexpected = {'purpose': 'confidential-gpu-storage-persistence/v1', 'model': 'Qwen3-0.6B'}\nif canary.exists():\n    require(json.loads(canary.read_text()) == expected, 'persistent canary mismatch')\n    print('STORAGE_DATA_REOPEN_PASS', flush=True)\nelse:\n    with canary.open('x') as stream:\n        json.dump(expected, stream, sort_keys=True)\n        stream.flush()\n        os.fsync(stream.fileno())\n    fd = os.open(DATA, os.O_DIRECTORY)\n    os.fsync(fd)\n    os.close(fd)\n    print('STORAGE_DATA_FIRST_WRITE_PASS', flush=True)\nfor name in ['tmp', 'hf', 'vllm', 'triton', 'cache', 'home']:\n    (DATA / name).mkdir(exist_ok=True)\nimport torch\nrequire(torch.cuda.is_available() and torch.cuda.device_count() == 1, 'exactly one CUDA GPU required')\na = torch.arange(4096, dtype=torch.int32, device='cuda')\nrequire(torch.equal((a + a).cpu(), torch.arange(4096, dtype=torch.int32) * 2), 'CUDA vector addition failed')\nprint(json.dumps({'event': 'CUDA_GPU_PROBE_PASS', 'device': torch.cuda.get_device_name(0),\n                  'torch': torch.__version__, 'cuda': torch.version.cuda}), flush=True)\ndel a\n# GPU confidentiality is gated by composite Trustee attestation before storage\n# opens. Successful CUDA arithmetic alone is not proof of confidential mode.\nos.execvp('vllm', ['vllm', 'serve', str(MODEL), '--served-model-name', 'qwen3-0.6b',\n                  '--host', '0.0.0.0', '--port', '8000', '--dtype', 'bfloat16',\n                  '--max-model-len', '2048', '--max-num-seqs', '4',\n                  '--gpu-memory-utilization', '0.25', '--enforce-eager',\n                  '--disable-log-requests', '--generation-config', 'vllm'])\n"
