+        let mut wrong = wait();
+        wrong.exec_id = "other".into();
+        assert!(service.do_wait_process(wrong).await.is_err());
+        owner.exit.send_replace(Some(42));
+        let (a, b) = tokio::join!(
+            service.do_wait_process(wait()),
+            service.do_wait_process(wait())
