+        block_close: AtomicBool,
+        wait_on_exit: AtomicBool,
+        entered: Notify,
+        finish: Notify,
+        pid: AtomicI32,
+        exit: watch::Sender<Option<i32>>,
+    }
+    impl TestOwner {
+        fn new() -> Arc<Self> {
+            Arc::new(Self {
+                starts: AtomicUsize::new(0),
+                closes: AtomicUsize::new(0),
+                stdin_closes: AtomicUsize::new(0),
+                fail_close: AtomicBool::new(false),
+                block_close: AtomicBool::new(false),
+                wait_on_exit: AtomicBool::new(false),
+                entered: Notify::new(),
+                finish: Notify::new(),
+                pid: AtomicI32::new(-1),
+                exit: watch::channel(None).0,
+            })
+        }
+    }
+    #[async_trait]
+    impl Managed for TestOwner {
+        async fn start(&self) -> Result<()> {
+            self.starts.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        }
+        async fn close(&self) -> Result<()> {
+            self.closes.fetch_add(1, Ordering::SeqCst);
+            self.entered.notify_one();
+            if self.block_close.load(Ordering::SeqCst) {
+                self.finish.notified().await;
+            }
+            if self.wait_on_exit.load(Ordering::SeqCst) {
+                self.wait().await?;
+            }
+            anyhow::ensure!(
+                !self.fail_close.load(Ordering::SeqCst),
+                "injected storage cleanup failure"
+            );
+            Ok(())
+        }
+        async fn wait(&self) -> Result<i32> {
+            let mut rx = self.exit.subscribe();
+            loop {
+                if let Some(code) = *rx.borrow() {
+                    return Ok(code);
+                }
+                rx.changed().await?;
+            }
+        }
+        async fn close_stdin(&self) -> Result<()> {
+            self.stdin_closes.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        }
+        async fn observe(&self, event: &ChildExit<'_>) -> Result<bool> {
+            if event.pid() != self.pid.load(Ordering::SeqCst) {
+                return Ok(false);
+            }
+            self.exit.send_replace(Some(event.code()));
+            Ok(true)
+        }
+    }
