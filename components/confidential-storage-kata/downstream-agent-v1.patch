+    #[tokio::test]
+    async fn managed_storage_dispatch_preserves_ordinary_wait() {
+        let service = service();
+        let logger = slog::Logger::root(slog::Discard, o!());
+        let child = std::process::Command::new("/bin/sh")
+            .args(["-c", "exit 23"])
+            .spawn()
+            .unwrap();
+        let mut p =
+            Process::new(&logger, &oci::Process::default(), "ordinary", true, 0, None).unwrap();
+        p.pid = child.id() as i32;
+        // A bookkeeping fixture, not a started rustjail container. Close the
+        // unused child pipe ends and register parent streams for normal cleanup.
+        for fd in
+            IntoIterator::into_iter([p.stdin.take(), p.stdout.take(), p.stderr.take()]).flatten()
+        {
+            assert_eq!(unsafe { libc::close(fd) }, 0);
+        }
+        drop(p.get_reader(StreamType::ParentStdout));
+        drop(p.get_reader(StreamType::ParentStderr));
+        let ctr = LinuxContainer {
+            id: "ordinary".into(),
+            root: String::new(),
+            config: CreateOpts::default(),
+            cgroup_manager: Box::new(
+                rustjail::cgroups::mock::Manager::new("", &oci::Spec::default(), None).unwrap(),
+            ),
+            init_process_pid: p.pid,
+            init_process_start_time: 0,
+            uid_map_path: String::new(),
+            gid_map_path: String::new(),
+            processes: std::iter::once(("ordinary".into(), p)).collect(),
+            status: Default::default(),
+            created: std::time::SystemTime::now(),
+            logger: logger.clone(),
+        };
+        service.sandbox.lock().await.add_container(ctr).unwrap();
+        let waiter = {
+            let s = service.clone();
+            tokio::spawn(async move {
+                s.do_wait_process(protocols::agent::WaitProcessRequest {
+                    container_id: "ordinary".into(),
+                    ..Default::default()
+                })
+                .await
+                .unwrap()
+                .status
+            })
+        };
+        tokio::time::timeout(Duration::from_secs(3), async {
+            while !waiter.is_finished() {
+                crate::signal::handle_sigchild(logger.clone(), service.sandbox.clone())
+                    .await
+                    .unwrap();
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await
+        .unwrap();
+        assert_eq!(waiter.await.unwrap(), 23);
+        assert!(service
+            .sandbox
+            .lock()
+            .await
+            .get_container("ordinary")
+            .unwrap()
+            .processes
+            .is_empty());
+        drop(child);
+    }
+}
