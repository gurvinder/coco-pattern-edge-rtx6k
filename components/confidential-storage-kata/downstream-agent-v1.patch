+// SPDX-License-Identifier: Apache-2.0
+//! Inert until a guest-authenticated provider calls install(). No host RPC can
+//! register an owner, and the confidential_mount preflight still fails closed.
+use crate::sandbox::Sandbox;
+use anyhow::{anyhow, ensure, Result};
+use async_trait::async_trait;
+use confidential_storage_guest::{
+    agent_lifecycle::{Agent, ConsumerBackend, Identity},
+    linux_backend::ConsumerHandles,
+    receipt::VerifiedGrant,
+};
+use confidential_storage_kata_adapter::{
+    process::{ChildExit, ProcessHandle},
+    runtime::KataRuntime,
+};
+use rustjail::{container::LinuxContainer, process::Process};
+use std::{
+    collections::BTreeMap,
+    fmt,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+};
+use tokio::sync::{Mutex, OwnedMutexGuard};
+
+#[async_trait]
+pub(crate) trait Managed: Send + Sync {
+    async fn start(&self) -> Result<()>;
+    async fn close(&self) -> Result<()>;
+    async fn wait(&self) -> Result<i32>;
+    async fn close_stdin(&self) -> Result<()>;
+    async fn observe(&self, event: &ChildExit<'_>) -> Result<bool>;
+}
+
+pub(crate) struct Entry {
+    id: String,
+    owner: Arc<dyn Managed>,
+    operations: Mutex<()>,
+    closed: AtomicBool,
+    removing: AtomicBool,
+}
+impl fmt::Debug for Entry {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ManagedStorageEntry")
+            .field("id", &self.id)
+            .field("closed", &self.closed())
+            .finish_non_exhaustive()
+    }
+}
+impl Entry {
+    fn new(id: String, owner: Arc<dyn Managed>) -> Arc<Self> {
+        Arc::new(Self {
+            id,
+            owner,
+            operations: Mutex::new(()),
+            closed: AtomicBool::new(false),
+            removing: AtomicBool::new(false),
+        })
+    }
+    pub fn closed(&self) -> bool {
+        self.closed.load(Ordering::Acquire)
+    }
+    pub async fn start(self: &Arc<Self>) -> Result<()> {
+        let entry = self.clone();
+        tokio::spawn(async move {
+            let _operation = entry.operations.lock().await;
+            ensure!(
+                !entry.removing.load(Ordering::Acquire),
+                "managed container is closing or closed"
+            );
+            entry.owner.start().await
+        })
+        .await
+        .map_err(|_| anyhow!("managed start worker failed; ownership retained"))?
+    }
+    pub async fn close(self: &Arc<Self>) -> Result<()> {
+        let entry = self.clone();
+        tokio::spawn(async move {
+            let _operation = entry.operations.lock().await;
+            if entry.closed() {
+                return Ok(());
+            }
+            entry.removing.store(true, Ordering::Release);
+            entry.owner.close().await?;
+            entry.closed.store(true, Ordering::Release);
+            Ok(())
+        })
+        .await
+        .map_err(|_| anyhow!("managed close worker failed; ownership retained"))?
+    }
+    pub fn check_exec(&self, exec_id: &str) -> Result<()> {
+        ensure!(
+            exec_id.is_empty() || exec_id == self.id,
+            "managed exec ID is not the owned init"
+        );
+        Ok(())
+    }
+    pub async fn wait(&self, exec_id: &str) -> Result<i32> {
+        self.check_exec(exec_id)?;
+        self.owner.wait().await
+    }
+    pub async fn close_stdin(&self, exec_id: &str) -> Result<()> {
+        self.check_exec(exec_id)?;
+        self.owner.close_stdin().await
+    }
+    pub async fn observe(&self, event: &ChildExit<'_>) -> Result<bool> {
+        self.owner.observe(event).await
+    }
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct Registry {
+    pub gate: Arc<Mutex<()>>,
+    entries: BTreeMap<String, Arc<Entry>>,
+    pub shutting_down: bool,
+}
+impl Registry {
+    pub fn entry(&self, cid: &str) -> Option<Arc<Entry>> {
+        self.entries.get(cid).cloned()
+    }
+    pub fn entries(&self) -> Vec<Arc<Entry>> {
+        self.entries.values().cloned().collect()
+    }
+    pub fn ordinary_allowed(&self) -> Result<()> {
+        ensure!(
+            !self.shutting_down && self.entries.is_empty(),
+            "guest reserved for managed confidential storage or teardown"
+        );
+        Ok(())
+    }
+    pub fn all_closed(&self) -> bool {
+        self.entries.values().all(|e| e.closed())
+    }
+    fn insert(
+        &mut self,
+        id: String,
+        owner: Arc<dyn Managed>,
+        ordinary_count: usize,
+    ) -> Result<Arc<Entry>> {
+        self.ordinary_allowed()?;
+        ensure!(
+            ordinary_count == 0,
+            "ordinary containers already own this guest"
+        );
+        kata_sys_util::validate::verify_id(&id)?;
+        let entry = Entry::new(id.clone(), owner);
+        self.entries.insert(id, entry.clone());
+        Ok(entry)
+    }
+    #[cfg(test)]
+    pub fn insert_test(
+        &mut self,
+        id: &str,
+        owner: Arc<dyn Managed>,
+        ordinary_count: usize,
+    ) -> Result<Arc<Entry>> {
+        self.insert(id.into(), owner, ordinary_count)
+    }
+}
+
+/// Gate precedes reaper/Sandbox/runtime locks. Clone it under Sandbox, release
+/// Sandbox, then await the gate. The reaper never acquires this operation gate.
+pub(crate) async fn operation(sandbox: &Arc<Mutex<Sandbox>>) -> OwnedMutexGuard<()> {
+    let gate = sandbox.lock().await.managed_storage.gate.clone();
+    gate.lock_owned().await
+}
+
+#[allow(dead_code)] // No provider/factory is wired through the hard activation gate.
+struct Owner<B: ConsumerBackend<ConsumerHandles>> {
+    agent: Arc<Agent<B, KataRuntime>>,
+    process: ProcessHandle,
+    id: String,
+}
+#[async_trait]
+impl<B: ConsumerBackend<ConsumerHandles>> Managed for Owner<B> {
+    async fn start(&self) -> Result<()> {
+        Ok(self.agent.start(&self.id).await?)
+    }
+    async fn close(&self) -> Result<()> {
+        Ok(self.agent.close(&self.id).await?)
+    }
+    async fn wait(&self) -> Result<i32> {
+        Ok(self.process.wait().await?)
+    }
+    async fn close_stdin(&self) -> Result<()> {
+        Ok(self.process.close_stdin().await?)
+    }
+    async fn observe(&self, event: &ChildExit<'_>) -> Result<bool> {
+        Ok(self.process.observe(event).await?)
+    }
+}
+
+/// Trusted guest-only seam. The caller must have authenticated the authority
+/// session/grant and performed measured OCI/device preflight. Never call from a
+/// host request by interpreting its annotation as a VerifiedGrant. No such caller
+/// exists in this patch. Install before preparing so failed effects retain an owner.
+#[allow(dead_code)]
+pub(crate) async fn install<B: ConsumerBackend<ConsumerHandles>>(
+    sandbox: Arc<Mutex<Sandbox>>,
+    container: LinuxContainer,
+    process: Process,
+    backend: B,
+    grant: VerifiedGrant,
+    device: String,
+    session: String,
+) -> Result<()> {
+    tokio::spawn(async move {
+        let _operation = operation(&sandbox).await;
+        ensure!(
+            session == grant.claims().session_sha256,
+            "authority session mismatch"
+        );
+        {
+            let s = sandbox.lock().await;
+            s.managed_storage.ordinary_allowed()?;
+            ensure!(
+                s.containers.is_empty(),
+                "ordinary containers already own this guest"
+            );
+        }
+        let id = Identity {
+            container_id: container.id.clone(),
+            container_name: grant.claims().container_name.clone(),
+            activation_id: grant.claims().activation_id.clone(),
+        };
+        let runtime = KataRuntime::new(id.clone(), container, process)?;
+        let observer = runtime.process_handle(&id).await?;
+        let agent = Agent::new(backend, runtime, session, 1);
+        let owner = Arc::new(Owner {
+            agent: agent.clone(),
+            process: observer,
+            id: id.container_id.clone(),
+        });
+        {
+            let mut s = sandbox.lock().await;
+            let count = s.containers.len();
+            s.managed_storage
+                .insert(id.container_id.clone(), owner, count)?;
+        }
+        agent.prepare(id.container_id, grant, device).await?;
+        Ok(())
+    })
+    .await
+    .map_err(|_| anyhow!("managed install worker failed; ownership retained"))?
+}
